# Local dev (SQLite) — omit DATABASE_URL
# SQLITE_PATH=data/wwtd.db

# Production (Supabase Postgres)
# DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@....pooler.supabase.com:6543/postgres

JWT_SECRET=change-me-in-production

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# Blue: password; green: hybrid; final cutover: google
AUTH_MODE=password
DEPLOYMENT_COLOR=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
